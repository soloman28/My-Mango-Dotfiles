// Inspired by Catnap (https://github.com/iinsertNameHere/catnap)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 0
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            // draw borders first to make colors of left and right border consistant
            "type": "title",
        },
        {
            "key": "{icon} distro ",
            "type": "os",
        },
        {
            "key": " kernel ",
            "type": "kernel",
        },
        {
            "key": "󰇄 WM     ",
            "type": "wm",
        },
        {
            "key": " term   ",
            "type": "terminal",
        },
        {
            "key": " shell  ",
            "type": "shell",
        },
        {
            "key": "󰉉 disk   ",
            "type": "disk",
            "folders": "/",
        },
        {
            "key": " memory ",
            "type": "memory",
        },
        {
            "type": "colors",
            "symbol": "square",
        }
    ]
}
