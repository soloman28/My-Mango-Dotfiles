/* ROUNDED THEME FOR ROFI */
/* Author: Newman Sanchez (https://github.com/newmanls) */

@theme "colors.rasi"

* {
    bg0:    @surface;
    bg1:    @surface;
    bg2:    @surface;
    bg3:    @primary;
    fg0:    @on-surface;
    fg1:    @on-surface;
    fg2:    @on-surface;
    fg3:    @outline;
}
